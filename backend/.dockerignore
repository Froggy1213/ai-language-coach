# Build context for backend/Dockerfile.
# Keep this tight: the context is sent to the daemon on every build.

# Version control / editor
.git
.gitignore
.idea
.vscode
.DS_Store
.editorconfig

# Environment files — production config comes from real env vars (ECS/Secrets
# Manager), never from a file baked into the image.
.env
.env.*
.env.backup

# Dependencies — installed inside the build stages, never copied from the host.
# Without these two lines the context would carry hundreds of MB.
node_modules
vendor

# Build output — produced inside the build stages (npm run build, composer).
public/build
public/storage

# Runtime state that must not leak from a developer machine into an image.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
bootstrap/cache/*
.phpunit.result.cache
.phpunit.cache

# Dev-only tooling and docs
tests
rector.php
README.md
CLAUDE.md
AGENTS.md
.agents
.claude
.github

# docker/ is deliberately NOT ignored — the runtime stage copies nginx.conf,
# supervisord.conf and the php.ini/php-fpm overrides from it.
