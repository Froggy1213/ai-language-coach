APP_NAME="AI Language Coach"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0 — docker compose service `mysql` (host port 3306).
# These credentials match docker-compose.yml and work out of the box locally.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=language_coach
DB_USERNAME=coach_user
DB_PASSWORD=coach_password

# Queue/cache/session tables live in MySQL. The deployed target is Redis
# (Horizon, ElastiCache) — switch these to `redis` once the phpredis
# extension or predis/predis is available.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Lighthouse caches parsed queries as PHP objects; `store` mode would need
# `cache.serializable_classes`, which Laravel 13 disables by default to block
# gadget chains. OPcache mode writes plain PHP files to bootstrap/cache instead.
LIGHTHOUSE_QUERY_CACHE_MODE=opcache
# Controls debug flags in GraphQL responses. Defaults to NONE when APP_DEBUG=false,
# or INCLUDE_DEBUG_MESSAGE | INCLUDE_TRACE when APP_DEBUG=true.
# LIGHTHOUSE_DEBUG=0

# GraphQL subscriptions (plan §5). The broadcaster must be `reverb`: it is the
# pusher driver wired to broadcasting.connections.reverb, not to Pusher cloud.
LIGHTHOUSE_BROADCASTER=reverb
# Subscriptions must live in Redis. Any Laravel cache store goes through
# CacheStorageManager, and Laravel 13's `cache.serializable_classes => false`
# turns the stored Subscriber into an unusable __PHP_Incomplete_Class on read.
LIGHTHOUSE_SUBSCRIPTION_STORAGE=redis
# Подписки живут в Redis до этой границы. Без TTL они копятся вечно, а подписчик
# удалённого пользователя не восстанавливается из хранилища — это ломает broadcast.
LIGHTHOUSE_SUBSCRIPTION_STORAGE_TTL=3600

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Assessment recordings (plan §5). The defaults below point at the MinIO
# service in docker-compose, so a fresh checkout can presign and read uploads
# without AWS. For the real bucket set AWS_ENDPOINT= (empty), the region, the
# credentials and AWS_BUCKET; keep AWS_USE_PATH_STYLE_ENDPOINT=false there.
AWS_ACCESS_KEY_ID=coach_minio
AWS_SECRET_ACCESS_KEY=coach_minio_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=coach-audio
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# The address the learner's browser posts a recording to, when that is not the
# one above — needed only by `--profile full`, where this backend signs against
# `minio:9000`, a name a browser cannot resolve. Leave it empty on the host and
# on AWS: there one endpoint serves both audiences.
AWS_PUBLIC_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Reverb WebSocket server — generate real values with `php artisan install:broadcasting`
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Sanctum SPA auth from the Nuxt dev server
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Sentry (fill in before the AWS deploy, §7 checklist)
SENTRY_LARAVEL_DSN=

# Onboarding assessment pipeline (plan §5).
# Deepgram batch STT for the submitted recording. The package defaults are
# Nova-2 and en-US (`config/deepgram-laravel.php`); only the key is required.
DEEPGRAM_API_KEY=

# CEFR analysis. `laravel/ai` reads DEEPSEEK_API_KEY; the provider is always
# named explicitly because `ai.default` points at OpenAI. Confirm the model id
# against the account before the AWS deploy (§7).
DEEPSEEK_API_KEY=
# ASSESSMENT_ANALYSIS_MODEL=deepseek-chat
# ASSESSMENT_ANALYSIS_TIMEOUT=120

# LiveKit (self-hosted, plan §5). The same key pair signs access tokens, the
# server API calls and the webhook signature — there is no second secret.
# LIVEKIT_API_SECRET must be at least 32 characters: HS256 signs with a 256-bit
# key and php-jwt refuses anything shorter. Generate one with
# `openssl rand -base64 32`.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# How long a learner's access token stays valid (the SDK default of 6 hours is
# far too generous — the token only has to outlive the handshake).
# LIVEKIT_TOKEN_TTL_MINUTES=15
# The name the Python agent registers under with `agent_name`; must match, or
# dispatch reaches nobody and every session ends in VOICE_FLEET_BUSY.
# VOICE_AGENT_NAME=ai-language-coach
# How long requestVoiceToken waits for a dispatched worker to join the room
# before answering VOICE_FLEET_BUSY.
# VOICE_AGENT_JOIN_TIMEOUT=5
# How long an empty room survives before LiveKit closes it as idle. This is the
# backstop for a learner who closes the tab: the room_finished event that
# follows is what marks the session `abandoned`.
# VOICE_ROOM_EMPTY_TIMEOUT=300
# Daily cap on voice sessions per learner (plan §7 cost guard). Defaults to 10;
# set <= 0 to disable.
# VOICE_DAILY_SESSION_LIMIT=10

# Shared secret for `POST /internal/sessions/{id}/fail` and `POST /internal/sessions/{id}/turns`,
# which the voice agent calls to report fatal errors or per-turn latency. Leave it empty
# and the endpoints refuse every request (503) rather than accepting anonymous
# reports.
VOICE_INTERNAL_SECRET=

# Spaced repetition & recurring error detection (plan §3, §7).
# Rolling window in days for detecting recurring mistakes across distinct sessions.
# REVIEW_RECURRING_WINDOW_DAYS=7
# Minimum number of distinct voice sessions with mistakes on a grammar point
# required within the window to flag it as a recurring error.
# REVIEW_RECURRING_SESSION_THRESHOLD=3

# Privacy & Data Retention policies (plan §5, §7).
# Retention window in days for voice session transcripts before purging them.
# PRIVACY_TRANSCRIPT_RETENTION_DAYS=90
# Retention window in days for orphan S3 assessment audio before purging them.
# PRIVACY_ORPHAN_AUDIO_RETENTION_DAYS=7

# Observability (plan §1, §7).
# Error tracking. Empty means the SDK never attempts delivery; the Laravel
# package is auto-discovered, so a DSN is the only thing "connecting" it.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Tracing stays off until someone decides to pay for it: errors only by default.
SENTRY_TRACES_SAMPLE_RATE=

# The metrics sink behind the CloudWatch P95 dashboard (plan §7). Off by
# default so a local run needs no AWS credentials; credentials come from the
# same AWS_* block the S3 client uses, or from the ECS task role.
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_METRICS_NAMESPACE=AiLanguageCoach/Voice
CLOUDWATCH_METRICS_REGION=us-east-1
CLOUDWATCH_METRICS_ENVIRONMENT=
CLOUDWATCH_METRICS_TIMEOUT=3

# Per-learner voice-minutes budget that `php artisan voice:usage-report`
# measures against; the AWS Budgets alert covers the account's spend.
VOICE_MONTHLY_MINUTES_BUDGET=300
