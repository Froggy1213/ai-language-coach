# Production environment for the single-host Docker deployment.
#
#   cp .env.production.example .env.production
#   # fill in every value marked REQUIRED, then:
#   docker compose --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml \
#     --profile full up -d mysql redis api horizon reverb web proxy
#
# This file is read by `docker compose` itself (interpolation), not by the
# application containers: their configuration arrives as environment variables
# from docker-compose.prod.yml. `.env.production` is git-ignored — keep it that
# way; it holds every secret the deployment has.
#
# Values written `${VAR:?message}` in docker-compose.prod.yml are refused by
# Compose until they are set here, so a missing key is a startup error rather
# than a container that boots and fails later.

# ---------------------------------------------------------------------------
# Application origin
# ---------------------------------------------------------------------------
# The hostname the SPA, the API and Reverb are all served from. DNS for it must
# point at this host before the first `up`, or Caddy cannot obtain a certificate.
APP_DOMAIN=coach.example.com

# REQUIRED. Signs sessions, cookies and signed URLs. Generate once and keep it:
# rotating it invalidates every session and every signed URL.
#   php artisan key:generate --show
# or: openssl rand -base64 32 | sed 's/^/base64:/'
APP_KEY=

# Optional. A second DNS record pointing at this host, used only if you keep the
# bundled MinIO instead of a real S3 bucket — uncomment the storage block in
# docker/Caddyfile as well.
# STORAGE_DOMAIN=storage.coach.example.com

# The compose network's subnet. Pinned because TRUSTED_PROXIES (below) depends on
# it: changing one without the other means the application stops believing the
# proxy's X-Forwarded-* headers and every rate limit collapses into one bucket.
DOCKER_SUBNET=172.28.0.0/16

# ---------------------------------------------------------------------------
# Database (the `mysql` service is created from these)
# ---------------------------------------------------------------------------
MYSQL_DATABASE=language_coach
MYSQL_USER=coach_user
# Database password for MYSQL_USER. REQUIRED. It must match the value the application is given (docker-compose.yml passes the same variable to the mysql service and to the API).
MYSQL_PASSWORD=
# Root password for the mysql container. REQUIRED. Only used for administration and backups.
MYSQL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage for the onboarding recordings
# ---------------------------------------------------------------------------
# The learner's browser POSTs the recording straight to the bucket, so whatever
# this points at has to be reachable from the internet.
#
# (a) Real S3 (recommended): leave both endpoints empty, fill in the keys, and
#     set AWS_USE_PATH_STYLE_ENDPOINT=false.
# (b) Bundled MinIO: AWS_ENDPOINT=http://minio:9000 (the API's own address for
#     it), AWS_PUBLIC_ENDPOINT=https://<STORAGE_DOMAIN>, path style true, and the
#     MinIO credentials below. Uncomment the storage block in docker/Caddyfile.
AWS_ENDPOINT=
AWS_PUBLIC_ENDPOINT=
# S3 credentials. REQUIRED. For a real bucket this is an IAM user with access to AWS_BUCKET; for the bundled MinIO it is MINIO_ROOT_USER below.
AWS_ACCESS_KEY_ID=
# REQUIRED. The matching secret.
AWS_SECRET_ACCESS_KEY=
# REQUIRED. The bucket the onboarding recordings are uploaded to. It must already exist when a real S3 bucket is used (the bundled MinIO creates it on start).
AWS_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=false

# Only consulted when the bundled MinIO is used (they are also its root login).
MINIO_ROOT_USER=coach_minio
# REQUIRED only when the bundled MinIO is used. It is also the S3 secret in that setup.
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# LiveKit (voice sessions)
# ---------------------------------------------------------------------------
# Both addresses are normally the same external node. LIVEKIT_URL is what the API
# and the voice agent dial; LIVEKIT_PUBLIC_URL is what the learner's browser
# dials. The secret must be 32+ characters: php-jwt refuses shorter HMAC keys.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_PUBLIC_URL=wss://livekit.example.com
# REQUIRED. The key pair the API, the agent and the LiveKit node all sign with.
LIVEKIT_API_KEY=
# REQUIRED, and 32+ characters: php-jwt refuses a shorter HMAC key at signing time.
LIVEKIT_API_SECRET=

# Shared secret for the agent's internal callbacks
# (openssl rand -hex 32). The endpoints that check it answer 503 while it is
# unset rather than accepting every caller.
# REQUIRED. Generate with `openssl rand -hex 32`.
VOICE_INTERNAL_SECRET=
VOICE_AGENT_NAME=ai-language-coach

# ---------------------------------------------------------------------------
# Speech and analysis providers
# ---------------------------------------------------------------------------
# REQUIRED. Batch transcription of the onboarding recording.
DEEPGRAM_API_KEY=
# REQUIRED. CEFR assessment and mistake analysis.
DEEPSEEK_API_KEY=

# Dialogue model for the voice agent. Empty means "infer the fastest provider
# whose key is present"; a provider the latency benchmark disqualified (DeepSeek)
# makes the agent refuse to start unless ALLOW_SLOW_DIALOGUE_LLM=true.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
CARTESIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Reverb (GraphQL subscriptions)
# ---------------------------------------------------------------------------
# Generate a fresh app rather than reusing the development one:
#   APP_ID:  an integer; APP_KEY/APP_SECRET: random strings.
# REQUIRED. An integer, and different from the development value.
REVERB_APP_ID=
# REQUIRED. Random string.
REVERB_APP_KEY=
# REQUIRED. Random string.
REVERB_APP_SECRET=

# ---------------------------------------------------------------------------
# Observability and limits (all optional)
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
CLOUDWATCH_METRICS_ENABLED=false
VOICE_MONTHLY_MINUTES_BUDGET=300

# The database is published on loopback only, so it can be reached for a backup
# or an interactive `mysql` client over SSH — never from the network. Change the
# host port if it collides with something else on the machine.
MYSQL_PORT=3306
