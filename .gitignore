# Настройки редакторов
.idea/
.vscode/

# macOS
.DS_Store

# Переменные окружения и ключи
.env
.env.backup
.env.production

# Зависимости
node_modules/
vendor/

# Python (voice agent)
__pycache__/
*.pyc
.venv/

# Сборка и логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.nuxt/
.output/
storage/*.key

# Playwright
test-results/
playwright-report/


# Playwright saved session for the e2e smoke suite
e2e/.auth/
.auth/

# Terraform: provider cache and local state are machine-specific and enormous
# (the AWS provider alone is ~650 MB); `.terraform.lock.hcl` stays tracked
# because it is the dependency lockfile a build must reproduce.
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
crash.log
