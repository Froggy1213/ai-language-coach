# LiveKit Server connection.
#
# For running the agent NATIVELY (`python agent.py dev`). Under Docker this file
# is not used at all — docker-compose supplies LIVEKIT_URL=ws://livekit:7880,
# because inside the container 127.0.0.1 is the agent itself, not the server.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=99fed3cd67e98cae5fa57a9aec3818d317f5e8a54f67c87e
VOICE_AGENT_NAME=ai-language-coach

# Audio / Models
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=
# CARTESIA_MODEL=sonic-3

# Speech recognition and synthesis. The target language comes from the job
# metadata, so nothing here needs to know it — but a voice is not language
# neutral, so each language has its own: CARTESIA_VOICE_DE, DEEPGRAM_TTS_MODEL_DE
# and OPENAI_TTS_VOICE_DE override the general setting for German.
DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=          # defaults per language (aura-2-thalia-en for English)
# CARTESIA_VOICE=              # defaults per language, built into agent.py
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# LLM Configuration.
#
# This is the model that answers the learner, so it is the one place where latency
# beats price: benchmarks/README.md measured deepseek-chat at 1068 ms p95
# time-to-first-token against a 600 ms budget and disqualified it for speech. It
# stays right for the asynchronous analysis jobs (mistake analysis, CEFR
# assessment), which run in Laravel, not here.
#
# With LLM_PROVIDER unset the agent infers the fastest provider whose key is
# present; naming a disqualified provider fails at startup rather than producing a
# fleet that pauses after every utterance.
# LLM_PROVIDER=groq            # groq | cerebras | openai | any OpenAI-compatible id
# LLM_MODEL=                   # empty = the provider's benchmarked default
# LLM_BASE_URL=                # empty = the provider's own endpoint
# LLM_API_KEY=                 # universal override for whichever provider is selected
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# ALLOW_SLOW_DIALOGUE_LLM=false # deliberate override, e.g. for a local model

# Turn handling (plan §5). Turn detection is on by default and runs LiveKit's
# on-device end-of-utterance model: the weights ship inside the
# livekit-local-inference wheel (34 MB, ~70 ms to load, no network), so there is
# nothing to download and no LiveKit Cloud dependency. `dynamic` endpointing lets
# that model stretch the silence window while a learner is mid-sentence instead of
# committing the turn after a fixed wait.
TURN_DETECTION=true
ENDPOINTING_MODE=dynamic
ENDPOINTING_MIN_DELAY_SECONDS=0.3
ENDPOINTING_MAX_DELAY_SECONDS=2.5
PREEMPTIVE_GENERATION=true

# Backend Internal API for reporting failures (POST /api/internal/sessions/{id}/fail)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
VOICE_INTERNAL_SECRET=

# Observability / Sentry Error Tracking (plan §1, §7)
# Initialised ONLY when SENTRY_DSN is set; completely disabled (no-op) when empty.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=          # Environment name (defaults to SENTRY_ENVIRONMENT, then APP_ENV, then 'local')
# SENTRY_RELEASE=              # Application release tag (e.g. git commit hash)
# SENTRY_TRACES_SAMPLE_RATE=0  # Tracing sample rate (default 0: errors only)

# Worker pool capacity (plan §5, §7)
#
# livekit-agents 1.8.5 does not read these from the environment by itself and
# has no max_processes field at all: the concurrency ceiling is load_threshold
# plus the container's CPU. Measured with load/dispatch_capacity.py — four
# prewarmed processes answer a dispatch in ~265 ms p50 (flat up to four at
# once) while a process spawned on demand takes ~538 ms, both far inside
# VOICE_AGENT_JOIN_TIMEOUT. The pool is idle *processes*, so it costs memory
# rather than CPU; the ECS task is 1 vCPU / 2 GB and still has to be measured
# on the real node (see load/README.md).
NUM_IDLE_PROCESSES=4
LOAD_THRESHOLD=0.7
# How long an in-flight call may finish after SIGTERM. The livekit-agents default
# is an hour, which turns every deploy into an hour-long drain, so this is capped
# well below it. On Fargate the cap cannot be raised past 120 s: ECS caps a
# container stopTimeout there and SIGKILLs whatever is left, so the drain sits
# just under it and the worker exits on its own terms. Letting a longer call
# survive a deploy needs ECS Task Scale-In Protection, not a larger number here.
DRAIN_TIMEOUT_SECONDS=110
