# Nuxt runtime config overrides.
# Only NUXT_PUBLIC_* values are exposed to the browser; never put secrets here.
# Copy to .env and adjust for your machine.
# See nuxt.config.ts -> runtimeConfig.

# Laravel backend origin (GraphQL over HTTP + WebSocket subscriptions).
NUXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Reverb WebSocket server (Laravel Echo / Pusher protocol).
# APP_KEY must match REVERB_APP_KEY in backend/.env.
NUXT_PUBLIC_REVERB_APP_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http

# LiveKit (self-hosted) — reserved for the November voice milestone.
NUXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
