# Build context for frontend/Dockerfile.

# Version control / editor
.git
.gitignore
.idea
.vscode
.DS_Store

# Environment files. Excluded on purpose: in the container, runtime config comes
# from real NUXT_PUBLIC_* environment variables, not from a developer's .env
# (see README -> "Note on .env files").
.env
.env.*

# Dependencies and build output — both are produced inside the image.
node_modules
.nuxt
.output
dist

# Docs and logs
README.md
npm-debug.log*
yarn-debug.log*
yarn-error.log*
