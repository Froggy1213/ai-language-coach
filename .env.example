# Host-level overrides for docker-compose.yml.
# Copy to `.env` in this directory: `cp .env.example .env`
#
# These are NOT the application settings — Laravel reads backend/.env and Nuxt
# reads frontend/.env. Changing a value here means also updating the matching
# DB_* / REDIS_* / AWS_* / LIVEKIT_* keys in backend/.env. The one exception is
# the `--profile full` block at the bottom, which *is* application configuration:
# those containers have no .env file of their own.
#
# Keep MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD in sync with backend/.env.

APP_NAME=Kirie

MYSQL_DATABASE=language_coach
MYSQL_USER=coach_user
MYSQL_PASSWORD=coach_password
MYSQL_ROOT_PASSWORD=root_password

# Local S3 (MinIO). backend/.env must point AWS_ENDPOINT at the API port and
# use these same credentials, otherwise presigned uploads are signed for a
# bucket that does not exist.
MINIO_ROOT_USER=coach_minio
MINIO_ROOT_PASSWORD=coach_minio_password
AWS_BUCKET=coach-audio

# MinIO image overrides, usually left alone.
#
# quay.io stopped serving the MinIO repositories anonymously on 2025-09-24
# (MinIO deleted its Docker Hub repositories on 2025-09-11), so pulling a
# *fresh* MinIO image on a clean machine answers
# `unauthorized: access to the requested resource is not authorized` until
# `docker login quay.io` succeeds with a free account. These two variables are
# the escape hatch for a mirror, an internal registry, or a tag that is already
# in the local image cache.
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
# MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# The address the learner's *browser* posts the recording to under
# `--profile full`, where the API container signs against `minio:9000` — a name
# a browser cannot resolve. Defaults to the published MinIO port; only change it
# together with MINIO_PORT. The default profile does not consult it: Laravel
# runs on the host there, and its own AWS_ENDPOINT already is the browser's URL.
AWS_PUBLIC_ENDPOINT=

# LiveKit server settings
LIVEKIT_PORT=7880
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=99fed3cd67e98cae5fa57a9aec3818d317f5e8a54f67c87e
VOICE_WEBHOOK_URL=http://host.docker.internal:8000/api/webhooks/livekit

# The address the learner's *browser* dials. Only consulted when LIVEKIT_URL is
# not already reachable from the browser — i.e. `--profile full`, where the API
# container dials ws://livekit:7880 and hands the browser this instead. Leave
# empty for the default profile: Laravel runs on the host there, and its own
# LIVEKIT_URL (ws://localhost:7880) is already the browser's URL.
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880

# Voice Agent settings (for containerized voice-agent service)
VOICE_AGENT_NAME=ai-language-coach
# Daily cap on voice sessions per learner (plan §7 cost guard; defaults to 10).
# VOICE_DAILY_SESSION_LIMIT=10
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=
VOICE_INTERNAL_SECRET=

# Dialogue model (plan §5, §7). This is the model that answers the learner, so it
# is the one place where latency beats price: benchmarks/README.md measured
# deepseek-chat at 1068 ms p95 time-to-first-token against a 600 ms budget and
# disqualified it for speech (it stays right for the async analysis jobs).
# Leave LLM_PROVIDER unset and the agent infers the fastest provider whose key is
# present; it refuses to start on a disqualified one rather than pausing after
# every utterance. Put a fast key here to use one:
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=            # empty = the provider's benchmarked default
# LLM_BASE_URL=         # empty = the provider's endpoint
# ALLOW_SLOW_DIALOGUE_LLM=false
#
# DeepSeek is still the async model — CEFR assessment and mistake analysis.
ASSESSMENT_ANALYSIS_MODEL=deepseek-chat

# Speech recognition and synthesis. The language is taken from the session
# metadata, not from here; these pin the models and the voice.
#
# Two different variables, deliberately, because two different passes read them:
# the streaming agent reads DEEPGRAM_STT_MODEL, while the batch transcription in
# the onboarding assessment is issued by `dij-digital/deepgram-laravel`, which
# reads DEEPGRAM_DEFAULT_MODEL (and whose own fallback is still Nova-2). Setting
# only one of them leaves the two passes on different generations of the model.
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_DEFAULT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=            # per language; aura-2-thalia-en for English
CARTESIA_MODEL=sonic-3
# CARTESIA_VOICE=                # defaults per language; _DE, _FR … to override
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Turn handling (plan §5). Turn detection is on by default and runs LiveKit's
# on-device end-of-utterance model — the weights ship inside the
# livekit-local-inference wheel, so there is no LiveKit Cloud call and nothing to
# download. `dynamic` endpointing lets that model stretch the silence window
# while a learner is mid-sentence (a learner reaching for a word pauses where a
# native speaker would not) instead of committing after a fixed wait.
TURN_DETECTION=true
ENDPOINTING_MODE=dynamic
ENDPOINTING_MIN_DELAY_SECONDS=0.3
ENDPOINTING_MAX_DELAY_SECONDS=2.5
PREEMPTIVE_GENERATION=true

# Voice agent worker pool (plan §5, §7). Measured with load/dispatch_capacity.py:
# four prewarmed processes answer a dispatch in ~265 ms p50 against a 5 s join
# timeout. livekit-agents 1.8.5 has no max_processes field — the ceiling is
# LOAD_THRESHOLD plus the container's CPU. DRAIN_TIMEOUT_SECONDS is how long an
# in-flight call may finish after SIGTERM (the library default is an hour); it
# sits below the Fargate stopTimeout cap of 120 s, because Fargate SIGKILLs
# whatever is left and a larger number would only be a promise it cannot keep.
NUM_IDLE_PROCESSES=4
LOAD_THRESHOLD=0.7
DRAIN_TIMEOUT_SECONDS=110

# Error tracking (plan §1, §7). The Laravel DSN is read by the API container
# under `--profile full`; the agent reads SENTRY_DSN. Both are inert while empty.
SENTRY_LARAVEL_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
# Tracing stays off until someone decides to pay for it: errors only by default.
SENTRY_TRACES_SAMPLE_RATE=0

# Metrics sink and cost guard (plan §7). Off by default, so a local run never
# needs AWS credentials; when switched on, the voice pipeline publishes turn
# latency and voice seconds to CloudWatch under this namespace and the
# infrastructure's dashboard and budget alert are read from the same series.
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_METRICS_NAMESPACE=AiLanguageCoach/Voice
CLOUDWATCH_METRICS_REGION=us-east-1
CLOUDWATCH_METRICS_ENVIRONMENT=local
VOICE_MONTHLY_MINUTES_BUDGET=300

# Retention windows (plan §5, §7). Raw assessment audio is deleted as soon as it
# has been transcribed; these are the safety nets behind that.
PRIVACY_TRANSCRIPT_RETENTION_DAYS=90
PRIVACY_ORPHAN_AUDIO_RETENTION_DAYS=7

# Host ports. Change these if 3306/6379/9000/9001/7880 are already taken.
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# `--profile full` only — Laravel, Reverb, Horizon and Nuxt in containers.
#
# backend/.env and frontend/.env are excluded from those images
# (backend/.dockerignore, frontend/.dockerignore), so everything they would have
# supplied has to arrive as an environment variable. Everything else in the
# profile has a working local default; the four below have no sensible one.
# ---------------------------------------------------------------------------

# Copy APP_KEY from backend/.env (`php artisan key:generate` writes one there).
# Left empty, the profile falls back to a committed development key: fine on a
# laptop, never in production (plan §7 takes the real key from Secrets Manager).
APP_KEY=

# Copy the three REVERB_* values from backend/.env. Reverb refuses to start
# without them, and REVERB_APP_KEY must also match frontend/.env so the browser
# and the server agree on which app it is subscribing to.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Browser origins allowed to make credentialed cross-origin requests to the API
# (comma-separated). Never '*'. Defaults to the local Nuxt dev server.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CIDRs whose X-Forwarded-* headers the API believes (comma-separated). Empty =
# trust none, which is right locally. Never '*'.
# TRUSTED_PROXIES=

# The session and XSRF-TOKEN cookies are flagged Secure only over https. This
# local profile serves plain http, so it stays false; production sets it to true
# in laravel_common_env (infra/terraform/ecs.tf), where the ALB terminates TLS.
# SESSION_SECURE_COOKIE=false

# The remaining security knobs have production-sensible defaults baked into
# backend/config/*.php and are passed by the compose profile with those same
# values, so they are listed here only so they can be found and overridden.
# LIVEKIT_SERVER_TOKEN_TTL_SECONDS=60   # backend's own LiveKit admin token, not the learner's
# LIGHTHOUSE_MAX_QUERY_DEPTH=10
# LIGHTHOUSE_MAX_QUERY_COMPLEXITY=50
