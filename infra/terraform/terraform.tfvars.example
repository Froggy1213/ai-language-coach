# Example Terraform variables for AI Language Coach (Milestone 2)
# Copy to terraform.tfvars and customize before running terraform apply.

aws_region  = "us-east-1"
environment = "production"
name_prefix = "ai-language-coach"

# Domains
app_domain     = "coach.example.com"
livekit_domain = "livekit.example.com"

# Set to an existing ACM certificate ARN if already issued; leave empty to declare a new ACM cert
acm_certificate_arn = ""

# Data Protection (Plan §8)
# protect_data = true is the production default: enables RDS deletion protection,
# takes a final DB snapshot on destroy, and enables ALB deletion protection.
# For a disposable test stand, set protect_data = false so the ALB and the
# database can then be destroyed without a final snapshot.
protect_data = true

# Database & Cache sizing (Plan §8)
db_instance_class    = "db.t4g.small"
db_name              = "language_coach"
db_username          = "coach_user"
db_allocated_storage = 20
redis_node_type      = "cache.t4g.micro"

# Standalone LiveKit EC2 node (Plan §8)
livekit_instance_type     = "t4g.medium"
livekit_stop_grace_period = "900s" # 15 minutes SIGTERM drain
livekit_ssh_allowed_cidrs = ["203.0.113.10/32"] # Replace with your operator IP CIDR

# Voice Agent Fleet sizing (Plan §5, §7)
# Measured by load/dispatch_capacity.py: four prewarmed processes answer a
# dispatch in ~265 ms p50, an on-demand spawn takes ~538 ms, and a SIGTERM with
# a call in flight preserves the call. livekit-agents 1.8.5 has no max_processes
# field: the ceiling is load_threshold plus the task's CPU.
voice_agent_num_idle_processes = 4
voice_agent_load_threshold     = 0.7
# Fargate caps a container stopTimeout at 120s and SIGKILLs whatever is left, so
# the drain is configured *below* that cap: the worker exits on its own terms
# instead of being killed mid-call. A longer call cannot be drained on this
# launch type — that needs ECS Task Scale-In Protection, not a bigger number.
voice_agent_drain_timeout      = 110
voice_agent_stop_timeout       = 120
voice_agent_min_capacity       = 1
voice_agent_max_capacity       = 5

# Dialogue model & turn handling (Plan §5, §7)
#
# Plan §7 asks for the dialogue LLM to be chosen by the benchmark. It is the
# fastest candidate measured in benchmarks/README.md; set it here rather than
# relying on auto-detection, which used to fall back to the one provider the
# benchmark had disqualified. Requires GROQ_API_KEY in the app secret.
voice_agent_llm_provider = "groq"
voice_agent_llm_model    = "" # provider default (groq -> openai/gpt-oss-120b)
voice_agent_llm_base_url = "" # provider default

# The end-of-utterance model runs on-device (its weights ship inside the
# livekit-local-inference wheel), so this costs no network call. `dynamic` lets
# it stretch the silence window while a learner is mid-sentence instead of
# committing after a fixed wait.
voice_agent_turn_detection        = true
voice_agent_endpointing_mode      = "dynamic"
voice_agent_endpointing_max_delay = 2.5
voice_agent_preemptive_generation = true

# Storage & Privacy Lifecycle (Plan §5, §7)
cors_allowed_origins      = ["https://coach.example.com"]
audio_retention_days      = 1  # Raw audio cleanup safety net
transcript_retention_days = 90 # Transcript archive retention

# AWS Budgets & Alerts (Plan §7, §8)
monthly_budget_usd   = 120
budget_alert_emails  = ["ops@example.com"]
